{
  "name": "token-saver-rtk-ide",
  "displayName": "Token Saver for VS Code & Agentic IDEs",
  "description": "Smart token optimization & CLI compression proxy for VS Code, Cursor, Windsurf, Cline, Roo Code, Claude Code & Antigravity IDE using matured upstream open-sourced solutions.",
  "version": "1.11.0",
  "publisher": "terenceooi",
  "author": {
    "name": "Terence",
    "email": "terenceooi1688@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terenceooi99/token-saver-rtk-ide"
  },
  "homepage": "https://github.com/terenceooi99/token-saver-rtk-ide#readme",
  "bugs": {
    "url": "https://github.com/terenceooi99/token-saver-rtk-ide/issues"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "keywords": [
    "vscode",
    "copilot",
    "cursor",
    "windsurf",
    "cline",
    "roo-code",
    "claude-code",
    "antigravity",
    "rtk",
    "token-saver",
    "token-killer",
    "ai-agents",
    "context-window",
    "llm",
    "compression",
    "jevgraph",
    "knowledge-graph"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages"
  ],
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenSaver",
          "title": "RTK Token Saver",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "tokenSaver": [
        {
          "type": "webview",
          "id": "tokenSaver.sidebarView",
          "name": "Token Optimization",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokenSaver.openDashboard",
          "when": "view == tokenSaver.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "tokenSaver.toggle",
          "when": "view == tokenSaver.sidebarView",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "tokenSaver.openDashboard",
        "title": "Pop Out to Editor Tab",
        "category": "Token Saver",
        "icon": "$(screen-full)"
      },
      {
        "command": "tokenSaver.toggle",
        "title": "Toggle RTK Token Saving Mode",
        "category": "Token Saver",
        "icon": "$(zap)"
      },
      {
        "command": "tokenSaver.enable",
        "title": "Enable RTK Token Saving",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.disable",
        "title": "Disable RTK Token Saving",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.syncAllIdeRules",
        "title": "Sync Rules to All AI Agents (VS Code, Cursor, Windsurf, Cline, Claude, Antigravity)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.selectIdeTargets",
        "title": "Configure Target Agentic IDEs / AI Rules",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.checkUpdates",
        "title": "Sync & Check Upstream GitHub (RTK, Headroom, Ponytail, OmniRoute & Anti-Slop)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.updateRtk",
        "title": "Update & Sync Upstream GitHub (RTK, Headroom, Ponytail, OmniRoute & Anti-Slop)",
        "category": "Token Saver",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tokenSaver.syncPonytail",
        "title": "Fetch & Sync Ponytail from GitHub (Global IDE)",
        "category": "Token Saver",
        "icon": "$(sync)"
      },
      {
        "command": "tokenSaver.syncAntiSlop",
        "title": "Fetch & Sync Anti-Slop from GitHub (miqdadbadjuber/anti-slop)",
        "category": "Token Saver",
        "icon": "$(sync)"
      },
      {
        "command": "tokenSaver.syncJevGraph",
        "title": "Fetch & Sync JevGraph from GitHub (chenmingtang830/jevgraph)",
        "category": "Token Saver",
        "icon": "$(sync)"
      },
      {
        "command": "tokenSaver.insertDocumentJevGraph",
        "title": "Manual Insert Documents to JevGraph (File Explorer & Web Link)",
        "category": "Token Saver",
        "icon": "$(file-directory)"
      },
      {
        "command": "tokenSaver.resetJevGraph",
        "title": "Reset / Clear JevGraph Knowledge for Current Repository",
        "category": "Token Saver",
        "icon": "$(trash)"
      },
      {
        "command": "tokenSaver.buildJevGraph",
        "title": "Build Document Knowledge Graph (JevGraph)",
        "category": "Token Saver",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tokenSaver.toggleJevGraph",
        "title": "Toggle JevGraph Knowledge Graph Optimization",
        "category": "Token Saver",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tokenSaver.toggleAntiSlop",
        "title": "Toggle Anti-Slop Quality Filter & Rules",
        "category": "Token Saver",
        "icon": "$(shield)"
      },
      {
        "command": "tokenSaver.setAntiSlopMode",
        "title": "Configure Anti-Slop Mode (During / After / Ask / Off)",
        "category": "Token Saver",
        "icon": "$(gear)"
      },
      {
        "command": "tokenSaver.toggleHeadroom",
        "title": "Toggle Headroom Context Compression",
        "category": "Token Saver",
        "icon": "$(layers)"
      },
      {
        "command": "tokenSaver.installSkills",
        "title": "1-Click Skill Installation (/rtk-*, /ponytail & /antislop)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallSkills",
        "title": "Uninstall Skill Sets (Global or Workspace)",
        "category": "Token Saver",
        "icon": "$(trash)"
      },
      {
        "command": "tokenSaver.togglePonytail",
        "title": "Toggle Ponytail YAGNI Mode",
        "category": "Token Saver",
        "icon": "$(zap)"
      },
      {
        "command": "tokenSaver.syncGlobalRules",
        "title": "Sync Global Antigravity Rules (~/.gemini)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.showSavings",
        "title": "Show Token Savings Scoreboard (rtk gain)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.installCli",
        "title": "Install RTK CLI Tool",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.copyAiInstallPrompt",
        "title": "Copy AI Agent Install Prompt (RTK, Headroom, Ponytail & Anti-Slop)",
        "category": "Token Saver",
        "icon": "$(copy)"
      },
      {
        "command": "tokenSaver.copyInstallCommands",
        "title": "Copy Raw Shell Install Commands",
        "category": "Token Saver",
        "icon": "$(terminal)"
      },
      {
        "command": "tokenSaver.setPonytailMode",
        "title": "Configure Ponytail Mode (YAGNI & Output Token Saver)",
        "category": "Token Saver",
        "icon": "$(zap)"
      },
      {
        "command": "tokenSaver.runCompactDiff",
        "title": "Run Compact Diff (rtk git diff -U1)",
        "category": "Token Saver",
        "icon": "$(diff)"
      },
      {
        "command": "tokenSaver.generateAstOutline",
        "title": "Generate AST / Symbol Outline for Current File",
        "category": "Token Saver",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "tokenSaver.startOmniRoute",
        "title": "Start OmniRoute AI Gateway (Port 20128)",
        "category": "Token Saver",
        "icon": "$(globe)"
      },
      {
        "command": "tokenSaver.stopOmniRoute",
        "title": "Stop OmniRoute AI Gateway",
        "category": "Token Saver",
        "icon": "$(stop-circle)"
      },
      {
        "command": "tokenSaver.openOmniRouteUi",
        "title": "Open OmniRoute Web Dashboard (http://localhost:20128)",
        "category": "Token Saver",
        "icon": "$(browser)"
      },
      {
        "command": "tokenSaver.omniRouteDoctor",
        "title": "Run OmniRoute Gateway Diagnostics (omniroute doctor)",
        "category": "Token Saver",
        "icon": "$(pulse)"
      },
      {
        "command": "tokenSaver.installOmniRoute",
        "title": "Install OmniRoute Gateway (npm i -g omniroute)",
        "category": "Token Saver",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tokenSaver.copyOmniRouteConfig",
        "title": "Copy OmniRoute Vibe Coder Endpoint Config (Cursor / Cline / Claude)",
        "category": "Token Saver",
        "icon": "$(copy)"
      },
      {
        "command": "tokenSaver.toggleOmniRoute",
        "title": "Toggle OmniRoute AI Gateway Integration (On/Off)",
        "category": "Token Saver",
        "icon": "$(globe)"
      },
      {
        "command": "tokenSaver.enableOmniRoute",
        "title": "Enable OmniRoute AI Gateway",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.disableOmniRoute",
        "title": "Disable OmniRoute AI Gateway",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallUpstream",
        "title": "Uninstall Upstream GitHub Layer (RTK, Headroom, Ponytail, OmniRoute, Anti-Slop, Rules & Skills)",
        "category": "Token Saver",
        "icon": "$(trash)"
      },
      {
        "command": "tokenSaver.uninstallRtk",
        "title": "Uninstall RTK CLI (rtk-ai/rtk)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallHeadroom",
        "title": "Uninstall Headroom CCR Layer (headroomlabs-ai/headroom)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallPonytail",
        "title": "Uninstall Ponytail YAGNI Suite (DietrichGebert/ponytail)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallAntiSlop",
        "title": "Uninstall Anti-Slop Suite (miqdadbadjuber/anti-slop)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallOmniRoute",
        "title": "Uninstall OmniRoute AI Gateway (diegosouzapw/OmniRoute)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallJevGraph",
        "title": "Uninstall JevGraph Knowledge Graph Engine (chenmingtang830/jevgraph)",
        "category": "Token Saver"
      },
      {
        "command": "tokenSaver.uninstallAllUpstream",
        "title": "Uninstall All Upstream GitHub Layers (Full Clean Purge)",
        "category": "Token Saver"
      }
    ],
    "configuration": {
      "title": "Token Saver (RTK, Headroom, Ponytail, OmniRoute, Anti-Slop & JevGraph)",
      "properties": {
        "tokenSaver.enableOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable RTK token compression when opening a project."
        },
        "tokenSaver.antiSlopEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anti-Slop rules & filters from upstream miqdadbadjuber/anti-slop to eliminate generic AI UI, copy, and code comments."
        },
        "tokenSaver.antiSlopMode": {
          "type": "string",
          "enum": [
            "during",
            "after",
            "ask",
            "off"
          ],
          "default": "during",
          "description": "Anti-Slop usage mode: 'during' (filter slop while generating), 'after' (audit findings report), 'ask' (prompt each session), or 'off'."
        },
        "tokenSaver.headroomEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Headroom context compression (CCR / SmartCrusher / CodeCompressor) from upstream headroomlabs-ai/headroom."
        },
        "tokenSaver.jevGraphEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable JevGraph evidence-backed knowledge graph context optimization from upstream chenmingtang830/jevgraph."
        },
        "tokenSaver.jevGraphAutoBuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically build initial repository knowledge graph from existing documents on workspace startup."
        },
        "tokenSaver.jevGraphAutoWatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically watch repository and AI chat documents to auto-combine new or modified documents into JevGraph."
        },
        "tokenSaver.jevGraphProvider": {
          "type": "string",
          "enum": [
            "keyword",
            "jev",
            "local"
          ],
          "default": "keyword",
          "description": "Relation extraction provider for JevGraph: 'keyword' (100% offline, 0 external tokens), 'jev' (AI Gateway), or 'local'."
        },
        "tokenSaver.omniRouteEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable OmniRoute AI Gateway integration, auto-failover, and model router features."
        },
        "tokenSaver.omniRoutePort": {
          "type": "number",
          "default": 20128,
          "description": "Port for local OmniRoute AI Gateway (default 20128, accessible at http://localhost:20128)."
        },
        "tokenSaver.omniRouteAutoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start OmniRoute AI Gateway background process on IDE startup (only when omniRouteEnabled is true)."
        },
        "tokenSaver.omniRouteEndpoint": {
          "type": "string",
          "default": "http://localhost:20128/v1",
          "description": "OpenAI-compatible endpoint URL for OmniRoute local proxy."
        },
        "tokenSaver.autoInstallSkills": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install Antigravity & Agent chat skills (/rtk-*, /ponytail & /antislop) on startup so Way 1 (Chat Commands) and Way 2 (Dashboard & Status Bar) are both available simultaneously."
        },
        "tokenSaver.targetScope": {
          "type": "string",
          "enum": [
            "all",
            "global",
            "workspace",
            "copilot",
            "cursor",
            "windsurf",
            "cline",
            "claude",
            "agents"
          ],
          "default": "all",
          "description": "Target IDE / Agent rule scope: 'all' (syncs to VS Code, Copilot, Cursor, Windsurf, Cline, Claude, Antigravity, AGENTS.md), 'global' (~/.gemini/config), or specific IDE."
        },
        "tokenSaver.checkForUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for newer RTK, Headroom, Ponytail, and Anti-Slop updates from upstream GitHub repositories on startup."
        },
        "tokenSaver.weeklyAutoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check and synchronize with upstream GitHub releases (RTK, Headroom, Ponytail & Anti-Slop) on a weekly schedule."
        },
        "tokenSaver.tokenPricePerMillion": {
          "type": "number",
          "default": 3.00,
          "description": "Estimated token pricing per 1,000,000 tokens in USD (used to calculate dollar cost savings)."
        },
        "tokenSaver.statusMetricDisplay": {
          "type": "string",
          "enum": [
            "compact",
            "verbose",
            "iconOnly"
          ],
          "default": "compact",
          "description": "Formatting of live metrics in the status bar item."
        },
        "tokenSaver.ponytailMode": {
          "type": "string",
          "enum": [
            "full",
            "lite",
            "ultra",
            "off"
          ],
          "default": "full",
          "description": "Ponytail YAGNI & Output Token Saver mode: 'full' (standard library first, shortest working diff, max 3 lines explanation), 'lite', 'ultra', or 'off'."
        },
        "tokenSaver.terseAgentMode": {
          "type": "boolean",
          "default": true,
          "description": "Direct agents to drop conversational pleasantries and filler text to maximize output token savings."
        },
        "tokenSaver.compactDiffContext": {
          "type": "boolean",
          "default": true,
          "description": "Direct AI agents to use single-line context (-U1) for git diffs to eliminate redundant surrounding lines."
        },
        "tokenSaver.astOutlineContext": {
          "type": "boolean",
          "default": true,
          "description": "Direct AI agents to inspect class and function symbol outlines (/rtk-outline) before reading full files into context."
        }
      }
    }
  },
  "scripts": {
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-vsix.ps1",
    "package-vsce": "npx @vscode/vsce package",
    "publish-ovsx": "npx ovsx publish"
  }
}