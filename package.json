    "configuration": {
      "title": "Token Saver (RTK, Headroom, Ponytail, OmniRoute, Anti-Slop, JevGraph & CodeGraph)",
      "properties": {
        "tokenSaver.enableOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically enable RTK token compression when opening a project."
        },
        "tokenSaver.antiSlopEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anti-Slop rules & filters from upstream miqdadbadjuber/anti-slop to eliminate generic AI UI, copy, and code comments."
        },
        "tokenSaver.antiSlopMode": {
          "type": "string",
          "enum": [
            "during",
            "after",
            "ask",
            "off"
          ],
          "default": "during",
          "description": "Anti-Slop usage mode: 'during' (filter slop while generating), 'after' (audit findings report), 'ask' (prompt each session), or 'off'."
        },
        "tokenSaver.headroomEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Headroom context compression (CCR / SmartCrusher / CodeCompressor) from upstream headroomlabs-ai/headroom."
        },
        "tokenSaver.jevGraphEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable JevGraph evidence-backed knowledge graph context optimization from upstream chenmingtang830/jevgraph."
        },
        "tokenSaver.jevGraphAutoBuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically build initial repository knowledge graph from existing documents on workspace startup."
        },
        "tokenSaver.jevGraphAutoWatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically watch repository and AI chat documents to auto-combine new or modified documents into JevGraph."
        },
        "tokenSaver.jevGraphProvider": {
          "type": "string",
          "enum": [
            "keyword",
            "jev",
            "local"
          ],
          "default": "keyword",
          "description": "Relation extraction provider for JevGraph: 'keyword' (100% offline, 0 external tokens), 'jev' (AI Gateway), or 'local'."
        },
        "tokenSaver.omniRouteEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable OmniRoute AI Gateway integration, auto-failover, and model router features."
        },
        "tokenSaver.omniRoutePort": {
          "type": "number",
          "default": 20128,
          "description": "Port for local OmniRoute AI Gateway (default 20128, accessible at http://localhost:20128)."
        },
        "tokenSaver.omniRouteAutoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start OmniRoute AI Gateway background process on IDE startup (only when omniRouteEnabled is true)."
        },
        "tokenSaver.omniRouteEndpoint": {
          "type": "string",
          "default": "http://localhost:20128/v1",
          "description": "OpenAI-compatible endpoint URL for OmniRoute local proxy."
        },
        "tokenSaver.autoInstallSkills": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install Antigravity & Agent chat skills (/rtk-*, /ponytail & /antislop) on startup so Way 1 (Chat Commands) and Way 2 (Dashboard & Status Bar) are both available simultaneously."
        },
        "tokenSaver.targetScope": {
          "type": "string",
          "enum": [
            "all",
            "global",
            "workspace",
            "copilot",
            "cursor",
            "windsurf",
            "cline",
            "claude",
            "agents"
          ],
          "default": "all",
          "description": "Target IDE / Agent rule scope: 'all' (syncs to VS Code, Copilot, Cursor, Windsurf, Cline, Claude, Antigravity, AGENTS.md), 'global' (~/.gemini/config), or specific IDE."
        },
        "tokenSaver.checkForUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for newer RTK, Headroom, Ponytail, and Anti-Slop updates from upstream GitHub repositories on startup."
        },
        "tokenSaver.weeklyAutoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check and synchronize with upstream GitHub releases (RTK, Headroom, Ponytail & Anti-Slop) on a weekly schedule."
        },
        "tokenSaver.tokenPricePerMillion": {
          "type": "number",
          "default": 3.00,
          "description": "Estimated token pricing per 1,000,000 tokens in USD (used to calculate dollar cost savings)."
        },
        "tokenSaver.statusMetricDisplay": {
          "type": "string",
          "enum": [
            "compact",
            "verbose",
            "iconOnly"
          ],
          "default": "compact",
          "description": "Formatting of live metrics in the status bar item."
        },
        "tokenSaver.ponytailMode": {
          "type": "string",
          "enum": [
            "full",
            "lite",
            "ultra",
            "off"
          ],
          "default": "full",
          "description": "Ponytail YAGNI & Output Token Saver mode: 'full' (standard library first, shortest working diff, max 3 lines explanation), 'lite', 'ultra', or 'off'."
        },
        "tokenSaver.terseAgentMode": {
          "type": "boolean",
          "default": true,
          "description": "Direct agents to drop conversational pleasantries and filler text to maximize output token savings."
        },
        "tokenSaver.compactDiffContext": {
          "type": "boolean",
          "default": true,
          "description": "Direct AI agents to use single-line context (-U1) for git diffs to eliminate redundant surrounding lines."
        },
        "tokenSaver.astOutlineContext": {
          "type": "boolean",
          "default": true,
          "description": "Direct AI agents to inspect class and function symbol outlines (/rtk-outline) before reading full files into context."
        },
        "tokenSaver.codeGraphEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeGraphContext pre-indexed semantic AST & call graph optimization for code files."
        },
        "tokenSaver.codeGraphAutoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically keep the semantic code graph updated in real-time when code files are saved."
        },
        "tokenSaver.hybridWebEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable 3-tier Hybrid Web search & scraping optimization (Discovery -> fastCRW -> Lightpanda MCP)."
        },
        "tokenSaver.crwEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable fastCRW (fastcrw/crw) fast static markdown scraping & search."
        },
        "tokenSaver.crwPort": {
          "type": "number",
          "default": 3000,
          "description": "Local port for fastCRW server (default: 3000)."
        },
        "tokenSaver.lightpandaEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Lightpanda Browser (lightpanda-io/browser) dynamic V8 JS rendering fallback via MCP."
        },
        "tokenSaver.lightpandaMcpPort": {
          "type": "number",
          "default": 8000,
          "description": "Local port for Lightpanda HTTP MCP server (default: 8000)."
        },
        "tokenSaver.eccEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ECC (affaan-m/ECC) strategic compaction, session milestone checkpoints (ck), and multi-model review."
        },
        "tokenSaver.eccAutoCompactEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically prompt strategic context compaction when reaching tool thresholds or milestone breaks."
        },
        "tokenSaver.eccAutoCkEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically snapshot session checkpoints (ck) to .agents/ck/ before major context pruning."
        },
        "tokenSaver.eccAutoCouncilEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically halt repetitive fail-and-retry loops and trigger multi-perspective council evaluation."
        },
        "tokenSaver.eccCompactToolThreshold": {
          "type": "number",
          "default": 50,
          "description": "Number of tool calls before suggesting strategic compaction to prune active context."
        },
        "tokenSaver.upstreamInstallPath": {
          "type": "string",
          "default": "",
          "description": "Base directory path for installing upstream GitHub repositories into their dedicated sub-folders (e.g. D:\\Software\\AI Agent Space)."
        }
      }
    }
  },
  "scripts": {
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-vsix.ps1",
    "package-vsce": "npx @vscode/vsce package",
